---
// Comparison table. A cell that is null prints "Not stated": never guess a competitor's detail
// (TONE_OF_VOICE.md, search page rules). Source links go in `sources` under the table.
interface Props {
  columns: string[];
  rows: { label: string; cells: (string | null)[] }[];
  sources?: { label: string; url: string }[];
  caption?: string;
}
const { columns, rows, sources = [], caption } = Astro.props;
---

<div class="overflow-x-auto rounded-ff-lg border border-ff-border">
  <table class="w-full min-w-[32rem] text-left text-sm">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead class="bg-ff-surface text-ff-ink">
      <tr>
        <th scope="col" class="p-3 font-semibold"><span class="sr-only">Feature</span></th>
        {columns.map((c) => <th scope="col" class="p-3 font-semibold">{c}</th>)}
      </tr>
    </thead>
    <tbody class="divide-y divide-ff-border">
      {
        rows.map((row) => (
          <tr>
            <th scope="row" class="p-3 font-medium text-ff-ink">{row.label}</th>
            {row.cells.map((cell) => (
              <td class:list={["p-3", cell === null ? "text-ff-muted italic" : "text-ff-ink"]}>
                {cell ?? "Not stated"}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{
  sources.length > 0 && (
    <p class="mt-3 text-sm text-ff-muted">
      Sources:{" "}
      {sources.map((s, i) => (
        <>
          <a class="underline" href={s.url} rel="noopener">{s.label}</a>
          {i < sources.length - 1 && ", "}
        </>
      ))}
    </p>
  )
}
