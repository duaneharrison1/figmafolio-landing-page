---
// Page section wrapper. width: "measure" for reading text, "wide" for grids and tables.
interface Props {
  width?: "measure" | "wide";
  tone?: "plain" | "surface";
  id?: string;
  class?: string;
}
const { width = "measure", tone = "plain", id, class: className } = Astro.props;
---

<section id={id} class:list={[tone === "surface" && "bg-ff-surface", "py-12 md:py-16", className]}>
  <div class:list={["mx-auto px-5", width === "measure" ? "max-w-ff-measure" : "max-w-ff-container"]}>
    <slot />
  </div>
</section>
