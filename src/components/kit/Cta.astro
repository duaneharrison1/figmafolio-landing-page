---
import Button from "./Button.astro";
import PriceLine from "./PriceLine.astro";
import { APP_SIGNUP_URL } from "@/data/plans";
interface Props {
  title?: string;
  text?: string;
  label?: string;
  href?: string;
  /** Set false on a page that states its own price (the country pages). */
  price?: boolean;
}
const {
  title = "Put your Figma prototype online",
  text = "Publish from Figma and get a link you can share.",
  label = "Get started",
  href = APP_SIGNUP_URL,
  price = true,
} = Astro.props;
---

<div class="rounded-ff-xl bg-ff-brand-tint border border-ff-border p-8 text-center">
  <h2 class="text-2xl font-semibold text-ff-ink">{title}</h2>
  <p class="mt-2 text-ff-muted">{text}</p>
  <div class="mt-5"><Button href={href}>{label}</Button></div>
  {price && <div class="mt-4"><PriceLine /></div>}
</div>
