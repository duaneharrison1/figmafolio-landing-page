---
// FAQ with matching FAQPage structured data. Answers are plain text so the markup equals what people read.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<div class="divide-y divide-ff-border border-y border-ff-border">
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="cursor-pointer list-none font-medium text-ff-ink flex justify-between gap-4">
          {item.q}
          <span class="text-ff-brand-hover group-open:rotate-45 transition" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-ff-muted">{item.a}</p>
      </details>
    ))
  }
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
