---
// Simplified picture of the site settings "Password" panel.
// Labels from figmaApp src/components/FormPassword/FormPassword.js. Re-check if that file changes.
// compact: only the switch and the password field.
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<figure class="w-full max-w-md" aria-label="Example of the Password settings">
  <div class="rounded-ff-xl border border-ff-border bg-ff-bg p-6 shadow-ff-card">
    {!compact && <p class="font-semibold text-ff-ink">Password</p>}
    {!compact && <p class="mt-2 text-xs text-ff-muted">Add an extra layer of security to your site or portfolio by requiring viewers to enter a password before they can access your work.</p>}
    <div class:list={["flex items-center justify-between rounded-ff-md bg-ff-surface px-4 py-3", !compact && "mt-5"]}>
      <span class="text-sm font-medium text-ff-ink">Enable Password Protection</span>
      <span class="flex h-6 w-11 items-center justify-end rounded-ff-pill bg-ff-brand px-0.5" aria-hidden="true"><span class="h-5 w-5 rounded-ff-pill bg-ff-bg"></span></span>
    </div>
    <div class="mt-3 flex gap-2">
      <div class="flex-1 rounded-ff-md border border-ff-border px-3 py-2 text-sm text-ff-muted">Enter a new password to change it</div>
      <span class="rounded-ff-pill bg-ff-brand px-4 py-2 text-sm font-medium text-ff-on-brand">Save</span>
    </div>
  </div>
  <figcaption class="mt-2 text-center text-xs text-ff-muted">Simplified picture of the settings screen.</figcaption>
</figure>
