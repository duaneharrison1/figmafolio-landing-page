---
// Simplified picture of the breakpoint setting in the site form. "Every screen size" and "up to ... px"
// are from figmaApp ViewportEditor.js. The widths here are examples.
---
<figure class="w-full max-w-md" aria-label="Example of a breakpoint setting">
  <div class="rounded-ff-xl border border-ff-border bg-ff-bg p-5 shadow-ff-card">
    <div class="flex items-center justify-between text-sm">
      <span class="font-medium text-ff-ink">Phone</span>
      <span class="flex items-center gap-2 text-ff-muted">up to <span class="rounded-ff-md border border-ff-brand px-3 py-1 text-ff-ink">767</span> px</span>
    </div>
    <div class="mt-4 flex items-center justify-between text-sm">
      <span class="font-medium text-ff-ink">Desktop</span>
      <span class="text-ff-muted">Everything wider</span>
    </div>
  </div>
  <figcaption class="mt-2 text-center text-xs text-ff-muted">Simplified picture. The width is an example.</figcaption>
</figure>
