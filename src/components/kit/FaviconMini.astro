---
// Simplified picture of the "Favicon" panel and a browser tab with the icon.
// Labels from figmaApp src/components/FormFavicon/FormFavicon.js. The example icon is a plain shape, not a real brand.
---
<figure class="w-full max-w-md" aria-label="Example of the Favicon settings and a browser tab">
  <div class="rounded-ff-xl border border-ff-border bg-ff-bg p-6 shadow-ff-card">
    <div class="flex items-end gap-1" aria-hidden="true">
      <div class="flex items-center gap-2 rounded-t-ff-md border border-b-0 border-ff-border bg-ff-surface px-3 py-2 text-xs text-ff-ink">
        <span class="h-4 w-4 rounded-ff-sm bg-ff-brand"></span>Example site
      </div>
      <div class="h-px flex-1 bg-ff-border"></div>
    </div>
    <p class="mt-5 font-semibold text-ff-ink">Favicon</p>
    <p class="mt-2 text-xs text-ff-muted">This is a small icon which will represent your website at the top of a web browser and in browser's bookmark bar, history and in search results.</p>
    <p class="mt-4 text-sm font-medium text-ff-ink">Website Icon</p>
    <div class="mt-2 flex items-center gap-3">
      <span class="h-12 w-12 rounded-ff-lg bg-ff-brand" aria-hidden="true"></span>
      <span class="rounded-ff-pill border border-ff-brand px-4 py-1.5 text-sm font-medium text-ff-brand-hover">Change image</span>
    </div>
    <p class="mt-3 text-xs text-ff-muted">Submit a PNG, JPG or SVG which is at least 70px x 70px. For best results, use an image which is 260px x 260px or more.</p>
  </div>
  <figcaption class="mt-2 text-center text-xs text-ff-muted">Simplified picture of the settings screen.</figcaption>
</figure>
