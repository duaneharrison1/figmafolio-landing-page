---
// Simplified picture of the note under a Figma link field.
// Words from figmaApp utils/figmaLinkCopy.js (NOTE_COPY). Links are examples.
// state: "viewable" (green line) or "notViewable" (panel with Show me how and Check again).
interface Props { state?: "viewable" | "notViewable"; }
const { state = "viewable" } = Astro.props;
---
<figure class="w-full max-w-md" aria-label="Example of the link check">
  <div class="rounded-ff-xl border border-ff-border bg-ff-bg p-5 shadow-ff-card">
    <p class="text-sm font-medium text-ff-ink">Desktop</p>
    <div class="mt-1.5 rounded-ff-md border border-ff-border px-3 py-2 text-sm text-ff-muted">https://www.figma.com/proto/...</div>
    {state === "viewable" ? (
      <p class="mt-2 flex items-center gap-2 text-sm text-ff-ink">
        <span class="h-2 w-2 shrink-0 rounded-ff-pill bg-ff-success"></span>
        Anyone with the link can open this prototype
      </p>
    ) : (
      <div class="mt-3 rounded-ff-md border border-ff-border bg-ff-surface p-3">
        <p class="flex items-center gap-2 text-sm font-medium text-ff-ink">
          <span class="h-2 w-2 shrink-0 rounded-ff-pill bg-ff-danger"></span>
          Visitors can't open this prototype yet.
        </p>
        <p class="mt-1 text-xs text-ff-muted">It isn't shared with everyone, or the link is wrong. Visitors would see a Figma error instead of your site.</p>
        <div class="mt-3 flex gap-2">
          <span class="rounded-ff-pill bg-ff-ink px-3 py-1 text-xs font-medium text-ff-bg">Show me how</span>
          <span class="rounded-ff-pill border border-ff-border px-3 py-1 text-xs font-medium text-ff-ink">Check again</span>
        </div>
      </div>
    )}
  </div>
  <figcaption class="mt-2 text-center text-xs text-ff-muted">Simplified picture of the link check.</figcaption>
</figure>
