---
// One plan: name, price, one line and what it includes. Prices come from the caller (the live price record),
// never typed here. Built for the country pages; the same card works on any page that states plan prices.
interface Props {
  name: string;
  price: string;
  per?: string;
  blurb: string;
  points: string[];
}
const { name, price, per = "a month", blurb, points } = Astro.props;
---

<div class="flex h-full flex-col rounded-ff-xl border border-ff-border bg-ff-bg p-6 md:p-8 shadow-ff-card">
  <h3 class="text-xl font-bold text-ff-ink">{name}</h3>
  <p class="mt-4 text-4xl font-bold tracking-tight text-ff-ink">{price}<span class="ml-1 text-base font-medium text-ff-muted">{per}</span></p>
  <p class="mt-3 text-ff-muted">{blurb}</p>
  <ul class="mt-6 space-y-3 border-t border-ff-border pt-6">
    {
      points.map((p) => (
        <li class="flex items-start gap-3 text-ff-ink">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-ff-pill bg-ff-brand-soft text-ff-brand-hover" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.8" /></svg>
          </span>
          {p}
        </li>
      ))
    }
  </ul>
</div>
