---
interface Props {
  title?: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<div class:list={["rounded-ff-lg border border-ff-border bg-ff-bg p-6 shadow-ff-card", className]}>
  {title && <h3 class="text-lg font-semibold text-ff-ink mb-2">{title}</h3>}
  <div class="text-ff-muted"><slot /></div>
</div>
