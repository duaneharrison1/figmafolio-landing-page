---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
const formatDate = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.snippet,
  datePublished: entry.data.publishDate.toISOString(),
  author: { "@type": "Organization", name: "Figmafolio" },
  publisher: { "@type": "Organization", name: "Figmafolio" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Layout title={entry.data.title} description={entry.data.snippet}>
  <Hero eyebrow={entry.data.category} title={entry.data.title} lede={entry.data.snippet ?? ""}>
    <p class="text-sm text-ff-muted">
      {entry.data.author} · <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
    </p>
  </Hero>
  <Section>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
    <p class="mt-10"><a class="text-ff-brand-hover underline" href="/blog">Back to the blog</a></p>
  </Section>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</Layout>
