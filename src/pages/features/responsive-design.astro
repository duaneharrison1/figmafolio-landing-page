---
import FeaturePage from "@/components/kit/FeaturePage.astro";
---
<FeaturePage
  title="Desktop and mobile on one link"
  description="Add a desktop prototype and a mobile prototype to one Figmafolio site. Visitors get the right one for their screen."
  lede="Design a desktop prototype and a mobile one in Figma. Figmafolio puts both on one link and shows the one that fits the visitor's screen."
  plan="It is not locked to a paid plan."
  steps={[
    { title: "Add your desktop prototype", text: "Paste the Figma prototype link for the desktop version." },
    { title: "Add your mobile prototype", text: "Paste the link for the mobile version." },
    { title: "Choose the breakpoint", text: "Set the screen width where the site switches to the mobile prototype." },
  ]}
  cards={[
    { title: "One link to send", text: "Share one address for both versions." },
    { title: "Your own breakpoint", text: "Set it per site in the Viewport editor." },
    { title: "Edits show on their own", text: "Change the prototype in Figma and the site updates without republishing." },
  ]}
  limits="Figmafolio does not adapt one design across phone, tablet and desktop. It shows the desktop prototype or the mobile one, whichever you added for that screen size."
  faq={[
    { q: "Do I need two prototypes?", a: "You need a mobile prototype only if you want visitors on phones to see a mobile design." },
    { q: "Is it locked to a paid plan?", a: "No." },
  ]}
  related={[{ href: "/figma-prototype-desktop-and-mobile-one-link", label: "One link for desktop and mobile" }, { href: "/figma-prototype-to-website", label: "Figma prototype to website" }]}
  checked="2026-11-21"
/>
