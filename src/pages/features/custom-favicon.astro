---
import FeaturePage from "@/components/kit/FeaturePage.astro";
import favImg from "@/assets/custom_favicon_landing.png";
---
<FeaturePage
  image={favImg}
  imageAlt="A browser tab showing a custom icon"
  title="Custom favicon"
  description="Use your own icon in the browser tab for your Figmafolio site. Available on Basic, Solo and Pro."
  lede="Replace the default tab icon with your own, so your site looks like yours."
  plan="Basic, Solo and Pro. The 7-day trial does not include it."
  steps={[
    { title: "Open your site in the dashboard", text: "Find the favicon setting." },
    { title: "Upload your icon", text: "Choose the image you want in the browser tab." },
    { title: "Check the tab", text: "Open your site and look at the browser tab." },
  ]}
  cards={[
    { title: "Your own mark", text: "Show your logo or initials in the tab." },
    { title: "Looks finished", text: "A tab with your icon looks less like a template." },
    { title: "Pairs with a label-free site", text: "Basic and above can also remove the Made with Figmafolio label." },
  ]}
  limits="A favicon only changes the small icon in the browser tab. It does not change the page title or the prototype."
  faq={[
    { q: "Which plans have it?", a: "Basic, Solo and Pro." },
    { q: "Is it on the free trial?", a: "No." },
  ]}
  related={[{ href: "/features/custom-domain", label: "Custom domain" }, { href: "/pricing", label: "Pricing" }]}
  checked="2026-11-21"
/>
