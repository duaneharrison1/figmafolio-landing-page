---
import FeaturePage from "@/components/kit/FeaturePage.astro";
---
<FeaturePage
  mini="site-link-domain"
  title="Custom domain"
  description="Show your Figma prototype portfolio at your own domain, like yourname.com. Available on Solo and Pro."
  lede="Point your own domain at your Figmafolio site, so people open yourname.com instead of a figmafolio.com address."
  plan="Solo and Pro. The Basic plan and the 7-day trial use a figmafolio.com address."
  steps={[
    { title: "Publish your prototype", text: "Paste your Figma prototype link into Figmafolio.", mini: "publish" },
    { title: "Choose Solo or Pro", text: "A custom domain is not on the trial or the Basic plan.", mini: "plans" },
    { title: "Connect your domain", text: "Add your domain to the site in Figmafolio. Your prototype then opens at your address.", mini: "domain" },
  ]}
  cards={[
    { title: "A link that is yours", text: "A cleaner address to put on a CV or application." },
    { title: "Desktop and mobile", text: "Add a prototype for each. The site picks one by screen size." },
    { title: "Edits show on their own", text: "The site embeds the live prototype, so Figma changes appear without republishing." },
  ]}
  limits="A custom domain does not turn your prototype into real web pages, and it is not an SEO tool. Figmafolio makes no promise about search rankings."
  faq={[
    { q: "Which plans have it?", a: "Solo and Pro." },
    { q: "Will it help me rank on Google?", a: "Figmafolio does not promise this. Treat it as a cleaner link to send." },
    { q: "Can I add a password too?", a: "Yes, on every paid plan." },
  ]}
  related={[{ href: "/figma-portfolio-own-domain", label: "Figma portfolio on your own domain" }, { href: "/features/password-protection", label: "Password protection" }]}
  checked="2026-11-21"
/>
