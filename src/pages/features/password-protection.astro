---
import FeaturePage from "@/components/kit/FeaturePage.astro";
---
<FeaturePage
  title="Password protection"
  description="Put a password on your Figmafolio site, for client work and NDA projects. Available on Basic, Solo and Pro."
  lede="Ask visitors for a password before they see your Figma prototype site. Useful for client work and projects under NDA."
  plan="Basic, Solo and Pro. The 7-day trial does not include it."
  steps={[
    { title: "Publish your prototype", text: "Paste your Figma prototype link into Figmafolio to get a live site." },
    { title: "Turn on the password", text: "Set the password for the site in the dashboard." },
    { title: "Send the link and the password", text: "Visitors enter the password before the site opens." },
  ]}
  cards={[
    { title: "Client work", text: "Share a project with one client without making it public." },
    { title: "NDA projects", text: "Show work to a recruiter or team who have the password." },
    { title: "Your own domain too", text: "Combine it with a custom domain on Solo or Pro." },
  ]}
  limits="The password protects your Figmafolio site, not the Figma prototype behind it. Figmafolio needs that prototype to be viewable by anyone with its link, so keep the original Figma link private."
  faq={[
    { q: "Which plans have it?", a: "Basic, Solo and Pro." },
    { q: "Does it protect the Figma link?", a: "No. It protects your Figmafolio site only. Figma has its own password on some paid Figma plans." },
    { q: "Can I use it with a custom domain?", a: "Yes, on the Solo and Pro plans." },
  ]}
  related={[{ href: "/password-protect-figma-prototype", label: "Password protect a Figma prototype" }, { href: "/features/custom-domain", label: "Custom domain" }]}
  checked="2026-11-21"
/>
