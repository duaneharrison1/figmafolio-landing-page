---
import FeaturePage from "@/components/kit/FeaturePage.astro";
---
<FeaturePage
  mini="analytics"
  title="Analytics"
  description="See visitors, where they come from and which devices they use on your Figmafolio site. Available on Solo and Pro."
  lede="See who opens your site: how many visitors, where they are, what they came from and what they use."
  plan="Solo and Pro. The trial and Basic plans do not include it."
  steps={[
    { title: "Publish your prototype", text: "Analytics is for a live site, on the Solo or Pro plan." },
    { title: "Open Analytics", text: "Pick a site, then a period: day, 7 days, 30 days or 12 months." },
    { title: "Read the numbers", text: "Check the totals, then the lists of sources, countries, devices, browsers and operating systems." },
  ]}
  cards={[
    { title: "Totals", text: "Unique visitors, total visits, pageviews, views per visit, bounce rate and visit duration." },
    { title: "Where people come from", text: "Sources and countries, so you can see if a recruiter email or a post worked." },
    { title: "What they use", text: "Devices, browsers and operating systems." },
  ]}
  limits="Analytics counts visits to your site. It does not show which part of your prototype people looked at inside Figma."
  faq={[
    { q: "Which plans have it?", a: "Solo and Pro." },
    { q: "Which periods can I see?", a: "Day, 7 days, 30 days and 12 months." },
  ]}
  related={[{ href: "/features/custom-domain", label: "Custom domain" }, { href: "/pricing", label: "Pricing" }]}
  checked="2026-11-21"
/>
