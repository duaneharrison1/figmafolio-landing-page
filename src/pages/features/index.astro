---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";
import Card from "@/components/kit/Card.astro";
import Cta from "@/components/kit/Cta.astro";
const features = [
  { href: "/features/responsive-design", title: "Desktop and mobile on one link", text: "Add a prototype for each. The site picks one by screen size.", plans: "Every plan" },
  { href: "/features/live-updates", title: "Edits show without republishing", text: "The site embeds the live prototype, so a Figma change shows on it.", plans: "Every plan" },
  { href: "/features/link-check", title: "Link check", text: "Know if visitors can open your prototype before you send it.", plans: "Every plan" },
  { href: "/features/password-protection", title: "Password protection", text: "Lock a site for client work or an NDA.", plans: "Basic, Solo and Pro" },
  { href: "/features/custom-favicon", title: "Custom favicon", text: "Your own icon in the browser tab.", plans: "Basic, Solo and Pro" },
  { href: "/features/custom-domain", title: "Custom domain", text: "Open your prototype at yourname.com.", plans: "Solo and Pro" },
  { href: "/features/analytics", title: "Analytics", text: "Visitors, visits, pageviews, bounce rate and visit duration.", plans: "Solo and Pro" },
];
---
<Layout title="Features" description="Everything Figmafolio does with a Figma prototype: one link for desktop and mobile, live updates, a link check, password, favicon, custom domain and analytics.">
  <Hero title="Features" lede="What Figmafolio does with your Figma prototype, and which plan has it." />
  <Section width="wide">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <a href={f.href} class="block">
          <Card title={f.title}>
            {f.text}
            <span class="mt-3 block text-sm font-medium text-ff-brand-hover">{f.plans}</span>
          </Card>
        </a>
      ))}
    </div>
  </Section>
  <Section width="wide"><Cta /></Section>
</Layout>
