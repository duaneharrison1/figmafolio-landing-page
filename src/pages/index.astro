---
import Container from "../components/container.astro";
import Features from "../components/features.astro";
import Hero from "../components/hero.astro";
import Logos from "../components/logos.astro";
import Layout from "../layouts/Layout.astro";
import { PH_ALTERNATES } from "@/data/locales";
import Section from "@/components/kit/Section.astro";
import Faq from "@/components/kit/Faq.astro";

const faq = [
  {
    q: "How does Figmafolio turn my Figma designs into a website?",
    a: "Figmafolio uses Figma's prototype embed to show your design as a live, interactive website. Your animations, transitions and interactions stay as you built them. Paste your Figma prototype link and publish. No coding or exporting. Updates you save in Figma show on your site without republishing.",
  },
  {
    q: "Do I need to know how to code?",
    a: "No. Create your portfolio in Figma, paste your prototype link into Figmafolio, and your site is live. Hosting and publishing are handled for you.",
  },
  {
    q: "Can I use my own custom domain?",
    a: "Yes, on the Solo and Pro plans. You connect a domain you own with a CNAME record, and your site is then reachable at an address like yourname.com. The Basic plan and the trial use a figmafolio.com address.",
  },
  {
    q: "What analytics can I see?",
    a: "Visitor counts, places by country and traffic sources, with trends over time. Analytics is on the Solo and Pro plans, and needs no code setup.",
  },
  {
    q: "Can I password protect my portfolio?",
    a: "Yes, on the Basic, Solo and Pro plans. It suits confidential work and NDA projects. Set a password in your dashboard and visitors enter it before they see your site. The 7-day trial does not include it.",
  },
  {
    q: "How much does it cost?",
    a: "Free for 7 days, then from $3 a month. After 7 days your site goes offline until you choose a plan. Prices vary a little by country, so check the pricing page for yours.",
  },
  {
    q: "Can I have multiple projects?",
    a: "Yes. Solo allows 3 sites and Pro has no limit. Each site has its own address and settings, and you manage them all from one dashboard.",
  },
];

---

<Layout alternates={PH_ALTERNATES} title="" description="Paste a Figma prototype link and get a live website in a few clicks. Custom domain, password protection and analytics. Free for 7 days.">
  <Container>
    <Hero />
    <Features />
    <Logos />
  </Container>

  <Section tone="surface" width="wide">
    <h2 class="mb-6">Guides</h2>
    <ul class="grid gap-3 text-ff-muted md:grid-cols-2">
      <li><a class="text-ff-brand-hover underline" href="/figma-prototype-to-website">Turn a Figma prototype into a website</a></li>
      <li><a class="text-ff-brand-hover underline" href="/figma-portfolio">Make a portfolio in Figma and put it online</a></li>
      <li><a class="text-ff-brand-hover underline" href="/password-protected-portfolio">Make a password protected portfolio</a></li>
      <li><a class="text-ff-brand-hover underline" href="/share-interactive-figma-prototype-with-clients">Share an interactive prototype with clients</a></li>
    </ul>
  </Section>

  <Section>
    <h2 class="mb-6">Questions</h2>
    <Faq items={faq} />
  </Section>

</Layout>
