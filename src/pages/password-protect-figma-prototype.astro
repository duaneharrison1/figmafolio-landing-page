---
// SEO page 6. Figmafolio facts: docs/figmafolio/PRODUCT.md. Figma facts: help.figma.com, read 21 Nov 2026.
import Layout from "@/layouts/Layout.astro";
import PasswordMini from "@/components/kit/PasswordMini.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";
import Button from "@/components/kit/Button.astro";
import Card from "@/components/kit/Card.astro";
import Steps from "@/components/kit/Steps.astro";
import Faq from "@/components/kit/Faq.astro";
import LastChecked from "@/components/kit/LastChecked.astro";
import PriceLine from "@/components/kit/PriceLine.astro";
import Cta from "@/components/kit/Cta.astro";
import { APP_SIGNUP_URL, PRICE_FOOTNOTE } from "@/data/plans";

const faq = [
  {
    q: "Does Figma have its own password for prototypes?",
    a: "Yes. Figma's help page lists password protection for the Professional, Education, Organization, Government and Enterprise plans, and it needs edit access to the file. The page does not list the free Starter plan.",
  },
  {
    q: "Which Figmafolio plans have a password?",
    a: "Basic, Solo and Pro. The 7-day trial does not.",
  },
  {
    q: "Does a Figmafolio password protect my Figma prototype itself?",
    a: "No. It protects your Figmafolio site. Figmafolio needs the Figma prototype to be viewable by anyone with its link, so keep the original Figma link private.",
  },
  {
    q: "Can I use both?",
    a: "Yes. Figma's password works on the Figma link. Figmafolio's works on the site you send.",
  },
  {
    q: "Is Figmafolio free?",
    a: "Free for 7 days, then from $3 a month. A password needs a paid plan.",
  },
];
---

<Layout
  title="Password protect a Figma prototype"
  description="How to password protect a Figma prototype: Figma's own password on paid plans, or a password on a Figmafolio site from Basic."
>
  <Hero
    eyebrow="Password protect a Figma prototype"
    title="Password protect a Figma prototype"
    lede="Figma has its own password for prototypes on some paid plans. Figmafolio adds one to the site you send, from the Basic plan. Both are below, so you can pick."
  >
    <Button href={APP_SIGNUP_URL}>Start the 7-day trial</Button>
    <Button href="/is-figmafolio-free" variant="secondary">Compare plans</Button>
    <PasswordMini slot="visual" />
  </Hero>

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-4">Option 1: Figma's own password</h2>
    <p class="text-ff-muted">Figma's help page lists password protection for the Professional, Education, Organization, Government and Enterprise plans, and you need edit access to the file. For a prototype, open Share prototype in the toolbar and turn on the password setting there. The page does not list the free Starter plan.</p>
  </Section>

  <Section tone="surface">
    <h2 class="text-2xl font-semibold text-ff-ink mb-4">Option 2: a password on your Figmafolio site</h2>
    <p class="text-ff-muted">Figmafolio puts your Figma prototype on a live site. From the Basic plan you can put a password on that site, which suits client work and NDA projects. The 7-day trial does not include it.</p>
    <div class="mt-8">
      <Steps
        items={[
          { title: "Publish your prototype", text: "Paste your Figma prototype link into Figmafolio and your site is live.", mini: "publish" },
          { title: "Turn on the password", text: "Switch on password protection for the site and choose a password of at least 6 characters.", mini: "password-compact" },
          { title: "Send the address and the password", text: "Visitors enter the password before they see your prototype.", mini: "site-link" },
        ]}
      />
    </div>
  </Section>

  <Section width="wide">
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">Which one to use</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <Card title="Use Figma's password when">You are already on a Figma plan that has it, and you only need to protect the Figma link.</Card>
      <Card title="Use a Figmafolio password when">You want to send one address that asks for a password, with your own domain on Solo or Pro, and you are not on a Figma plan with passwords.</Card>
    </div>
  </Section>

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-4">One thing to know</h2>
    <p class="text-ff-muted">A Figmafolio password protects your site, not the Figma prototype behind it. Figmafolio needs that prototype to be viewable by anyone with its link, so anyone who has the original Figma link can still open it in Figma. Keep that link to yourself.</p>
  </Section>

  <Section tone="surface">
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">Questions</h2>
    <Faq items={faq} />
  </Section>

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-3">Sources</h2>
    <ul class="list-disc pl-5 text-sm text-ff-muted space-y-1">
        <li><a class="text-ff-brand-hover underline" href="https://help.figma.com/hc/en-us/articles/5726720100247-Add-password-protection-to-files-and-prototypes">Add password protection to files and prototypes (Figma Help Center)</a></li>
    </ul>
  </Section>
  <Section tone="surface">
    <PriceLine footnote={false} />
    <p class="mt-2 text-sm text-ff-muted">{PRICE_FOOTNOTE} See <a class="text-ff-brand-hover underline" href="/pricing">pricing</a> for each plan.</p>
    <p class="mt-2 text-sm text-ff-muted">Related: <a class="text-ff-brand-hover underline" href="/figma-prototype-to-website">Figma prototype to website</a>.</p>
    <div class="mt-4"><LastChecked date="2026-11-21" /></div>
  </Section>

  <Section width="wide">
    <Cta />
  </Section>
</Layout>
