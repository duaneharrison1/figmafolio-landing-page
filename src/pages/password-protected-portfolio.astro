---
// Search page for "password protected portfolio". Facts: docs/figmafolio/PRODUCT.md (By plan).
// Words: docs/figmafolio/TONE_OF_VOICE.md. Figma-side password facts live on /password-protect-figma-prototype.
import Layout from "@/layouts/Layout.astro";
import PasswordMini from "@/components/kit/PasswordMini.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";
import Button from "@/components/kit/Button.astro";
import Card from "@/components/kit/Card.astro";
import Steps from "@/components/kit/Steps.astro";
import Faq from "@/components/kit/Faq.astro";
import LastChecked from "@/components/kit/LastChecked.astro";
import PriceLine from "@/components/kit/PriceLine.astro";
import Cta from "@/components/kit/Cta.astro";
import Answer from "@/components/kit/Answer.astro";
import { APP_SIGNUP_URL, PRICE_FOOTNOTE } from "@/data/plans";

const faq = [
  {
    q: "How do I make a password protected portfolio?",
    a: "Publish your Figma prototype with Figmafolio, switch on password protection for the site, and choose a password of at least 6 characters. Visitors enter it before they see your work. It is on the Basic, Solo and Pro plans.",
  },
  {
    q: "Does the 7-day trial include a password?",
    a: "No. A password needs a paid plan: Basic, Solo or Pro.",
  },
  {
    q: "Does the password protect my Figma file?",
    a: "No. It protects your Figmafolio site. Figmafolio needs the Figma prototype to be viewable by anyone with its link, so keep the original Figma link private.",
  },
  {
    q: "Can I use my own domain with a password?",
    a: "Yes. A custom domain is on the Solo and Pro plans, and the password works on those plans too.",
  },
  {
    q: "Can I lock one site and leave another open?",
    a: "The password is set for a site. Solo allows 3 sites and Pro has no limit, so you can keep one portfolio open and make another for a client.",
  },
  {
    q: "Is Figmafolio free?",
    a: "Free for 7 days, then from $3 a month. A password needs a paid plan.",
  },
];
---

<Layout
  title="Password protected portfolio"
  description="Put a password on your Figma portfolio so only people you choose can see it. On the Basic, Solo and Pro plans. Free for 7 days to try the rest."
>
  <Hero
    eyebrow="Password protected portfolio"
    title="Make a password protected portfolio"
    lede="Share your work with one recruiter, client or team without making it public. They get a link and a password."
  >
    <Button href={APP_SIGNUP_URL}>Start the 7-day trial</Button>
    <Button href="/features/password-protection" variant="secondary">See the feature</Button>
    <PasswordMini slot="visual" />
  </Hero>

  <Answer
    question="How do I make a password protected portfolio?"
    answer="Publish your Figma prototype with Figmafolio, then switch on password protection for the site and choose a password of at least 6 characters. Visitors enter the password before they see your work. It is available on the Basic, Solo and Pro plans."
    href="/password-protect-figma-prototype"
    linkText="Compare with Figma's own prototype password"
  />

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">Three steps</h2>
    <Steps
      items={[
        { title: "Publish your prototype", text: "Paste your Figma prototype link into Figmafolio and your site is live.", mini: "publish" },
        { title: "Turn on the password", text: "Switch on password protection for the site and choose a password.", mini: "password-compact" },
        { title: "Send the address and the password", text: "Visitors enter the password before they see your prototype.", mini: "site-link" },
      ]}
    />
  </Section>

  <Section tone="surface" width="wide">
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">When a password helps</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <Card title="Client work">Show a project to one client without making it public.</Card>
      <Card title="NDA projects">Let a recruiter or hiring team see work you cannot post openly.</Card>
      <Card title="Your own domain too">Put the locked site on yourname.com with the Solo or Pro plan.</Card>
    </div>
  </Section>

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-4">One thing to know</h2>
    <p class="text-ff-muted">The password protects your Figmafolio site, not the Figma prototype behind it. Figmafolio needs that prototype to be viewable by anyone with its link, so anyone who has the original Figma link can still open it in Figma. Keep that link to yourself.</p>
  </Section>

  <Section tone="surface">
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">Questions</h2>
    <Faq items={faq} />
  </Section>

  <Section>
    <PriceLine footnote={false} />
    <p class="mt-2 text-sm text-ff-muted">{PRICE_FOOTNOTE} See <a class="text-ff-brand-hover underline" href="/pricing">pricing</a> for each plan.</p>
    <p class="mt-2 text-sm text-ff-muted">Related: <a class="text-ff-brand-hover underline" href="/password-protect-figma-prototype">Password protect a Figma prototype</a>, <a class="text-ff-brand-hover underline" href="/figma-portfolio">Make a portfolio in Figma</a>.</p>
    <div class="mt-4"><LastChecked date="2026-11-22" /></div>
  </Section>

  <Section width="wide">
    <Cta />
  </Section>
</Layout>
