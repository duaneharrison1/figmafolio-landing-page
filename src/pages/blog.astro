---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";

// Published posts only, newest first.
const posts = await getCollection("blog", ({ data }) => !data.draft && data.publishDate < new Date());
posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Layout title="Blog" description="What is new in Figmafolio: one short post for each feature, with how it works and which plan has it.">
  <Hero title="Figmafolio blog" lede="One short post for each feature or change, with how it works and which plan has it." />
  <Section>
    <ul class="divide-y divide-ff-border">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="block py-6 hover:text-ff-brand-hover">
              <p class="text-sm text-ff-muted">
                <time datetime={post.data.publishDate.toISOString()}>{fmt.format(post.data.publishDate)}</time>
                {" · "}{post.data.category}
              </p>
              <h2 class="mt-1 text-xl font-semibold text-ff-ink">{post.data.title}</h2>
              {post.data.snippet && <p class="mt-1 text-ff-muted">{post.data.snippet}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
