---
// SEO page 3. Facts: docs/figmafolio/PRODUCT.md (By plan). Words: docs/figmafolio/TONE_OF_VOICE.md.
// No plan prices are listed: they vary by country, so the page links to pricing.
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";
import Button from "@/components/kit/Button.astro";
import ComparisonTable from "@/components/kit/ComparisonTable.astro";
import Faq from "@/components/kit/Faq.astro";
import LastChecked from "@/components/kit/LastChecked.astro";
import PriceLine from "@/components/kit/PriceLine.astro";
import Cta from "@/components/kit/Cta.astro";
import { APP_SIGNUP_URL, PRICE_FOOTNOTE } from "@/data/plans";

const faq = [
  {
    q: "Is FigmaFolio free?",
    a: "Free for 7 days, then from $3 a month. It is a 7-day trial, not a permanent free plan.",
  },
  {
    q: "What happens after 7 days?",
    a: "Your site goes offline for visitors until you choose a plan. The 7 days count from your first site, or from sign-up if you have not made one yet.",
  },
  {
    q: "How many sites can I have?",
    a: "The trial and the Basic plan allow 1 site. Solo allows 3. Pro has no limit.",
  },
  {
    q: "Which plan do I need for a custom domain?",
    a: "Solo or Pro.",
  },
  {
    q: "Which plan has a password for client work?",
    a: "Every paid plan: Basic, Solo and Pro.",
  },
  {
    q: "Do prices change by country?",
    a: "A little. The pricing page shows what each plan costs where you are.",
  },
];
---

<Layout
  title="Is FigmaFolio free?"
  description="FigmaFolio is free for 7 days, then from $3 a month. See what the trial and each plan include, and what happens to your site after 7 days."
>
  <Hero
    eyebrow="Is FigmaFolio free?"
    title="Is FigmaFolio free?"
    lede="Free for 7 days, then from $3 a month. The 7 days are a trial, not a permanent free plan. After they end, your site goes offline until you choose a plan."
  >
    <Button href={APP_SIGNUP_URL}>Start the 7-day trial</Button>
    <Button href="/pricing" variant="secondary">See pricing</Button>
  </Hero>

  <Section width="wide">
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">What each plan includes</h2>
    <ComparisonTable
      caption="FigmaFolio plans"
      columns={["Trial (7 days)", "Basic", "Solo", "Pro"]}
      rows={[
        { label: "Sites", cells: ["1", "1", "3", "No limit"] },
        { label: "Site stays online after 7 days", cells: ["No", "Yes", "Yes", "Yes"] },
        { label: "Password protection", cells: ["No", "Yes", "Yes", "Yes"] },
        { label: "Custom favicon", cells: ["No", "Yes", "Yes", "Yes"] },
        { label: "Custom domain", cells: ["No", "No", "Yes", "Yes"] },
        { label: "Analytics (visitors, places, sources)", cells: ["No", "No", "Yes", "Yes"] },
        { label: "\"Made with Figmafolio\" label removed", cells: ["No", "Yes", "Yes", "Yes"] },
      ]}
    />
    <p class="mt-4 text-sm text-ff-muted">Older legacy plans have their own site counts and are not shown here.</p>
  </Section>

  <Section width="wide">
    <h2 class="text-2xl font-semibold text-ff-ink mb-3">Prices by country</h2>
    <p class="text-ff-muted mb-6">Figmafolio sets the price by the buyer's country. Basic, monthly, in US dollars. Any country not listed pays the first row.</p>
    <ComparisonTable
      caption="Basic plan price by country"
      columns={["Countries"]}
      rows={[
        { label: "US$3", cells: ["US, Germany, Ukraine, Australia, Canada and all other countries", null] },
        { label: "US$2.50", cells: ["Ireland, UK, France, Japan, South Korea, Israel, Italy", null] },
        { label: "US$2", cells: ["Taiwan, Spain, Portugal, Poland", null] },
        { label: "US$1.50", cells: ["Philippines, Malaysia, China, Argentina, Brazil", null] },
        { label: "US$1", cells: ["Thailand, Vietnam, Indonesia, India, Nigeria", null] },
      ]}
    />
    <p class="mt-4 text-sm text-ff-muted">Solo and Pro follow the same country groups. Yearly billing is cheaper. Read from our own price records on 4 November 2026; the price you see at checkout is the one that counts.</p>
  </Section>

  <Section tone="surface">
    <h2 class="text-2xl font-semibold text-ff-ink mb-4">If you only need a quick link</h2>
    <p class="text-ff-muted">
      FigmaFolio puts your Figma prototype on a live site, so the trial is enough to send a link to a recruiter or client this week. If you need the link to stay up, choose a plan before day 7.
    </p>
  </Section>

  <Section>
    <h2 class="text-2xl font-semibold text-ff-ink mb-6">Questions</h2>
    <Faq items={faq} />
  </Section>

  <Section tone="surface">
    <PriceLine />
    <p class="mt-2 text-sm text-ff-muted">{PRICE_FOOTNOTE} See <a class="text-ff-brand-hover underline" href="/pricing">pricing</a> for each plan.</p>
    <p class="mt-2 text-sm text-ff-muted">Related: <a class="text-ff-brand-hover underline" href="/figma-prototype-to-website">Figma prototype to website</a>.</p>
    <div class="mt-4"><LastChecked date="2026-11-21" /></div>
  </Section>

  <Section width="wide">
    <Cta />
  </Section>
</Layout>
