---
// How it works. Rebuilt on the page kit (tokens only). Content as before, plus a short answer, FAQ markup and links to the guides.
// Facts: docs/figmafolio/PRODUCT.md.
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/kit/Hero.astro";
import Section from "@/components/kit/Section.astro";
import Button from "@/components/kit/Button.astro";
import Card from "@/components/kit/Card.astro";
import Steps from "@/components/kit/Steps.astro";
import Faq from "@/components/kit/Faq.astro";
import Answer from "@/components/kit/Answer.astro";
import PriceLine from "@/components/kit/PriceLine.astro";
import Cta from "@/components/kit/Cta.astro";
import landingCustomDomain from "@/assets/landing_custom_domain.png";
import landingPasswordProtection from "@/assets/password_protection_landing.png";
import { APP_SIGNUP_URL, PRICE_FOOTNOTE } from "@/data/plans";

const faq = [
  {
    q: "What Figma features are supported?",
    a: "Figmafolio supports all prototype features in Figma, including animations, transitions, scroll behaviors, hover states and interactive components. You can also use videos, GIFs and Figma's responsive prototype features. Whatever works in Figma's prototype preview will work on your published site.",
  },
  {
    q: "How do I get my prototype link from Figma?",
    a: "In Figma, click the Share button in the top right corner, then select Copy link under the prototype tab. Make sure your file's sharing settings allow anyone with the link to view. Paste this link into Figmafolio and you are ready to publish. Separate prototype links for desktop and mobile give the best experience on every screen.",
  },
  {
    q: "Do changes in Figma update automatically?",
    a: "Yes. Figmafolio embeds your Figma prototype directly, so updates you save in Figma appear on your published site without republishing in Figmafolio.",
  },
  {
    q: "Can I preview my site before publishing?",
    a: "Yes. After pasting your prototype links, use the preview in your dashboard to see both the desktop and mobile versions before you share the site.",
  },
];
---

<Layout
  title="How it works: Figma prototype to live website"
  description="How Figmafolio works: paste a Figma prototype link, publish, and share a live site with one link. Custom domain and password on paid plans."
>
  <Hero
    eyebrow="How it works"
    title="From Figma to a live website in 3 steps"
    lede="Design a prototype in Figma, paste its link into Figmafolio, and publish. Your site is live on its own address."
  >
    <Button href={APP_SIGNUP_URL}>Start the 7-day trial</Button>
    <Button href="/pricing" variant="secondary">See pricing</Button>
  </Hero>

  <Answer
    question="How does Figmafolio turn a Figma prototype into a website?"
    answer="You design a prototype in Figma, paste its link into Figmafolio, and publish. You get a live site with its own address that shows your prototype as you built it. You can add a custom domain on the Solo and Pro plans, and a password on any paid plan."
  />

  <Section width="wide">
    <h2 class="mb-10">Three steps</h2>
    <Steps
      items={[
        { title: "Design in Figma", text: "Skip learning other tools or coding. Bring your whole website or portfolio to life right in Figma, with transitions, GIFs and video to make it interactive." },
        { title: "Simple setup", text: "Sign up and paste in your Figma prototype links for desktop and mobile, so your site works for anyone visiting. Preview the site to see your designs working.", mini: "publish" },
        { title: "Go live", text: "Publish your site to start sending it to clients and recruiters. Updates made in Figma show on your site. Add your own domain name on the Solo and Pro plans.", mini: "site-link-domain" },
      ]}
    />
  </Section>

  <Section tone="surface" width="wide">
    <h2 class="mb-10">More control on paid plans</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <Card title="Custom domain" image={landingCustomDomain} imageAlt="A site on a custom domain">
        Connect your own domain like yourname.com on the Solo and Pro plans. <a class="text-ff-brand-hover underline" href="/features/custom-domain">Learn more</a>
      </Card>
      <Card title="Password protection" image={landingPasswordProtection} imageAlt="A password prompt on a site">
        Keep client work and NDA projects private with a password, from the Basic plan. <a class="text-ff-brand-hover underline" href="/features/password-protection">Learn more</a>
      </Card>
    </div>
  </Section>

  <Section>
    <h2 class="mb-6">Guides</h2>
    <ul class="space-y-2 text-ff-muted">
      <li><a class="text-ff-brand-hover underline" href="/figma-prototype-to-website">Turn a Figma prototype into a website</a></li>
      <li><a class="text-ff-brand-hover underline" href="/figma-portfolio">Make a portfolio in Figma and put it online</a></li>
      <li><a class="text-ff-brand-hover underline" href="/share-figma-prototype-anyone-can-open">Share a prototype so anyone can open it</a></li>
      <li><a class="text-ff-brand-hover underline" href="/password-protected-portfolio">Make a password protected portfolio</a></li>
    </ul>
  </Section>

  <Section tone="surface">
    <h2 class="mb-6">Questions</h2>
    <Faq items={faq} />
  </Section>

  <Section>
    <PriceLine footnote={false} />
    <p class="mt-2 text-sm text-ff-muted">{PRICE_FOOTNOTE} See <a class="text-ff-brand-hover underline" href="/pricing">pricing</a> for each plan.</p>
  </Section>

  <Section width="wide">
    <Cta />
  </Section>
</Layout>
