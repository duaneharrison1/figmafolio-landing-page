{
  "redirects": [
    { "source": "/features/user-testing", "destination": "https://aeroapp.ai", "permanent": true },
    { "source": "/blog/user-testing-vs-maze", "destination": "https://aeroapp.ai", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
